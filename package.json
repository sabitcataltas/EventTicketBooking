{
  "name": "event-ticket-booking",
  "private": true,
  "type": "module",
  "workspaces": [
    "api"
  ],
  "scripts": {
    "dev": "npm run dev -w api",
    "start": "npm start -w api",
    "test": "npm test -w api",
    "test:prepare": "docker compose -f MySQL/docker-compose.test.yml up -d --wait && DB_HOST=127.0.0.1 DB_PORT=3307 DB_USER=app DB_PASSWORD=app DB_NAME=event_ticket_booking_test npm test; code=$?; docker compose -f MySQL/docker-compose.test.yml down -v; exit $code",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type:check": "npm run type:check --workspaces --if-present"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.0.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.71.2"
  }
}
